# Qt-specific
*.pro.user
*.pro.user.*
*.qbs.user
*.qbs.user.*
*.moc
moc_*.cpp
moc_*.h
qrc_*.cpp
ui_*.h
*.qmlc
*.jsc
Makefile*
*build-*
*.autosave

# C++ build artifacts
*.o
*.obj
*.exe
*.dll
*.so
*.dylib
*.a
*.lib
*.exp
*.pdb

# Vendored runtime libraries (libpq + dependencies for Qt QPSQL driver) —
# explicitly tracked so the build is reproducible without a separate download.
!vendor/libpq-16/*.dll
*.ilk

# Build directories
build/
build-*/
debug/
release/
Debug/
Release/

# IDE specific
.vs/
.vscode/
*.suo
*.user
*.userosscache
*.sln.docstates
*.vcxproj.filters
*.vcxproj.user

# Installer output
dist/
!dataviewer_translator/dist/
dataviewer_translator/installer_output/

# Python bytecode
__pycache__/
*.pyc

# Inno Setup temp
Output/

# Qt deploy cache
.qmake.stash

# Auto-generated by qmake from VERSION (lives in DataViewerEnterprise.pro)
DataViewer_resource.rc

# Generated by Qt rcc (qmake fallback output on this Qt 6.10 build)
test_rcc_output.cpp

# Test data (user-specific Excel files)
test data/

# excel-sidecar/ ships the DataViewerUpload.bas module that lives in the
# Automated Testing Template. The reference .xlsm in this folder is the
# user's working copy — large binary, possibly MIP-labeled, not authoritative.
# The real template lives in OneDrive; the .bas is the only thing we track.
excel-sidecar/*.xlsm
excel-sidecar/*.xlsx

# Database files
*.db

# API keys / secrets
anthropic_api_key.txt

# OS specific
.DS_Store
Thumbs.db
desktop.ini

# Claude Code worktrees (local only)
.claude/worktrees/

# Test build logs
tests/**/build.log

# Test-run scratch (QtTest -o output redirected here; stdout/stderr captures)
tests/**/res.txt
tests/**/se.txt

# QtTest result files and per-suite build logs. Qt Test stdout is invisible in
# this environment, so every suite run is `-o results.txt,txt` - these pile up
# in every suite directory and are one `git add -A` from landing on a PUBLIC
# repo. Includes the results_corpus*.txt variants the v3 harnesses emit.
tests/**/results*.txt
tests/**/_mk.log
tests/**/.impeccable/

# Root-level run captures (full-suite, installer, and make logs)
_fullsuite_*.log
_installer_*.log
_mk_*.log
build/_*.log
tests/**/so.txt

# Outline harness rendered output (regenerated by tests/outline_harness/)
tests/outline_harness/outline_renders/
tests/outline_harness/release/
tests/outline_harness/debug/

# qmake-generated PATH/Qt-plugin wrappers for test binaries
tests/**/target_wrapper.sh

# Postgres deployment secrets and bind-mounted data
deploy/postgres/.env
deploy/postgres/data/

# Phone-sensory web service (DATAVIEWER-11): real DB password lives only in the
# NAS .env (repo is public); pytest/runtime caches are local-only.
deploy/sensory-collect/.env
deploy/sensory-collect/**/__pycache__/
deploy/sensory-collect/.pytest_cache/

# Superpowers plugin runtime state (local-only cache)
.superpowers/

# Upload-sidecar reset-seed template (local only; the one-time seed for
# RebuildBlankTemplates / SeedBlankTemplatesFromFile - not needed at runtime)
resources/templates/*DVE*.xlsm

# Plane MCP config (contains API token - never commit)
.mcp.json

# v3 golden-file corpus: real historical workbooks, local-only (repo is public)
tests/corpus/*
!tests/corpus/README.md
