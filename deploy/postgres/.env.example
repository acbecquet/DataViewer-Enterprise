# Copy to .env and set a strong password before running `docker compose up -d`.
# The .env file MUST NOT be committed. .gitignore already covers it.
DVE_DB_PASSWORD=change-me-to-a-strong-random-password

# DATAVIEWER-11: password for the least-privilege sensory_web role used by the
# phone web form (deploy/sensory-collect/). The migration creates the role with
# no password; set it out-of-band with `ALTER ROLE sensory_web PASSWORD ...`
# (see README.md). Placeholder only -- the real secret lives only in the NAS .env.
DVE_SENSORY_WEB_PASSWORD=change-me
